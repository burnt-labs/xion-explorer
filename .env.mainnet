# Build-time settings for the mainnet explorer (vite --mode mainnet). Vite
# inlines VITE_* when it builds, so they must live here: the deploy build does
# not read GitHub Environment variables. Not secrets; never put a secret in a
# VITE_ variable, it ships to every browser.

# Poll blocks/latest every second.
VITE_REFRESH_INTERVAL=1000

# Fill holes in the Recent block window (latest - limit, latest] on each poll.
VITE_FETCH_ALL_BLOCKS=true

# Blocks kept in the Recent block window.
VITE_RECENT_BLOCK_LIMIT=100
