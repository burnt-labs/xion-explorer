# Build-time settings for the testnet explorer (vite --mode testnet). Vite
# inlines VITE_* when it builds, so they must live here: the deploy build does
# not read GitHub Environment variables. Not secrets; never put a secret in a
# VITE_ variable, it ships to every browser.

# Poll blocks/latest every second.
VITE_REFRESH_INTERVAL=1000

# Fill holes in the Recent block window (latest - limit, latest] on each poll.
VITE_FETCH_ALL_BLOCKS=true

# Blocks kept in the Recent block window.
VITE_RECENT_BLOCK_LIMIT=100

# Market data through Burnt's CoinGecko proxy, which caches responses for 5 minutes.
VITE_COINGECKO_URL=https://coingecko-proxy.burnt.com

# Read IBC paths from the cosmos/chain-registry GitHub API. registry.ping.pub,
# the code's default source, is unreachable, so VITE_PINGPUB_API_URL is unset.
# GitHub allows 60 unauthenticated requests per hour per visitor IP.
VITE_IBC_USE_GITHUB_API=true
VITE_GITHUB_API_URL=https://api.github.com/repos/cosmos/chain-registry/contents
